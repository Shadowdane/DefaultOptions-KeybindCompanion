  "id": "defaultoptions_keybind_companion",
  "version": "${version}",
  "name": "Default Options Keybind Companion",
  "description": "A client-side helper mod that can forcibly reapply Default Options keybindings after all Fabric client key mappings have registered.",
  "authors": [
    "Shadowdane"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.shadowdane.defaultoptions.keybindcompanion.DefaultOptionsKeybindCompanion"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "=26.3",
    "fabric-api": ">=0.161.0+26.3"
  },
  "suggests": {
    "defaultoptions": "*"
  }
}
